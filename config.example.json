    "timeout_seconds": 8
  },
  "sqlite_url": "sqlite:///local_cache.db",
  "snapshot_dir": "snapshots",
  "snapshot_retention_days": 30,
  "snapshot_max_mb": 1024,
  "admin_pin": "1234",
  "recognition": {
    "provider": "insightface",
    "model_name": "buffalo_l",
