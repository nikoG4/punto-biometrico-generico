  "rrhh_only_active": true,
  "rrhh_attendance_user_id": null,
  "integration_mode": "generic_db",
  "generic_db": {
    "url": "mysql+pymysql://usuario:password@127.0.0.1:3306/rrhh",
    "employee_query": "SELECT id, code AS marker_code, name, COALESCE(status, '') AS status FROM employees WHERE (:query = '' OR name LIKE :query_like OR code LIKE :query_like) ORDER BY name LIMIT :limit",
    "attendance_insert_sql": "INSERT INTO attendance_events (employee_code, timestamp, type, device_id, confidence) VALUES (:marker_code, :timestamp, :type, :device_id, :confidence)",
    "biometric_faces_table": "biometric_faces"
  },
  "generic_rest": {
    "base_url": "",
    "token": "",
